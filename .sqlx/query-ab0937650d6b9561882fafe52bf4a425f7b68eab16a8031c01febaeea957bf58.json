  "query": "insert into maps (name, parent_id, tab_name, tab_order)\n           select '', $1, $2, coalesce(max(tab_order), -1) + 1\n           from maps where id = $1 or parent_id = $1\n           returning id as \"id!\", tab_name as \"name!\", false as \"is_root!\"",
